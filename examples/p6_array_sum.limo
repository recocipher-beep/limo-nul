# ============================================================
# PROGRAM 6: Array Sum Loop
# File: p6_array_sum.limo
# Purpose: Sum the integers 1..10 using a loop
# Expected results:
#   r3 = 55   (sum of 1..10)
#   r4 = 11   (loop counter after exit)
#   r5 = 10   (N)
#   r6 = 1    (increment)
#   r7 = 0    (halt marker)
# Cycle count: see note below
# ============================================================

eketsa_ha r3, r0, 0      # r3 = 0   (sum)
eketsa_ha r4, r0, 1      # r4 = 1   (i)
eketsa_ha r5, r0, 10     # r5 = 10  (N)
eketsa_ha r6, r0, 1      # r6 = 1   (increment)
loop:
  eketsa   r3, r3, r4     # sum += i
  eketsa   r4, r4, r6     # i++
  tabola_eseng r4, r5, loop  # if i != N, loop
end:
  eketsa_ha r7, r0, 0     # r7 = 0 (halt marker)